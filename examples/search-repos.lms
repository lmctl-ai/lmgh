# Searches repositories by query and prints full name, stars and description.
# Run:    lmscript examples/search-repos.lms <query>
query = ARGV.len() > 0 ? ARGV[0] : "octo";

p = _lmcode_ cli="lmgh";
let repos = gh.search_repos(${query}, 10);
for (i in range(0, repos.len())) {
  let r = repos.at(i);
  print(r.full_name() + " [" + str(r.stars()) + " stars] " + r.description());
  report.add("repo-hit", r.full_name(), str(r.stars()) + " stars, pushed " + r.pushed_at());
}
report.write_json("build/search-repos.json");
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
