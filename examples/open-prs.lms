# Lists open pull requests with number, title, author and branch.
# Run:    lmscript examples/open-prs.lms <owner> <repo>
out = ARGV.len() > 0 ? ARGV[0] : "build/open-prs.dslb";
owner = ARGV.len() > 1 ? ARGV[1] : "octo";
repo = ARGV.len() > 2 ? ARGV[2] : "demo";

p = _lmcode_ cli="lmgh" install="github:lmctl-ai/lmgh@latest";
let prs = gh.pr_list(${owner}, ${repo}, "open", 30);
for (i in range(0, prs.len())) {
  let pr = prs.at(i);
  let draft = "";
  if (pr.is_draft()) { draft = " [draft]"; }
  print("#" + str(pr.number()) + ": " + pr.title() + " (by @" + pr.author() + ", " + pr.head() + " -> " + pr.base() + ")" + draft);
  report.add("open-pr", ${owner} + "/" + ${repo}, "#" + str(pr.number()) + " " + pr.title());
}
report.write_text("build/open-prs.txt");
end _lmcode_
savedsl(p, out);
