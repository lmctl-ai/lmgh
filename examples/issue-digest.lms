# Open issue digest grouped by label; unlabeled issues land under "none".
# Run:    lmscript examples/issue-digest.lms <owner> <repo>
owner = ARGV.len() > 0 ? ARGV[0] : "octo";
repo = ARGV.len() > 1 ? ARGV[1] : "demo";

p = _lmcode_ cli="lmgh";
let issues = gh.issue_list(${owner}, ${repo}, "open", 50);
for (i in range(0, issues.len())) {
  let issue = issues.at(i);
  let labels = issue.labels();
  let label = "none";
  if (labels.len() > 0) { label = labels.at(0); }
  let line = "#" + str(issue.number()) + " " + issue.title() + " (@" + issue.author() + ")";
  report.add("issue-" + label, ${owner} + "/" + ${repo}, line);
  print(label + ": " + line);
}
report.write_json("build/issue-digest.json");
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
