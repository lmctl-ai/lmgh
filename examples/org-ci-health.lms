# Latest observed default-branch run per workflow (bounded to 100 runs/repo).
# Args: owner repo[,repo...] ; defaults octo/demo.
owner = ARGV.len() > 0 ? ARGV[0] : "octo";
repos = ARGV.len() > 1 ? ARGV[1] : "demo";
p = _lmcode_ cli="lmgh";
print("REPOSITORY WORKFLOW BRANCH RESULT");
for (repo in str_split(${repos}, ",")) {
  let info = gh.repo_view(${owner}, repo);
  let runs = gh.run_list(${owner}, repo, 100);
  let seen = str_list();
  for (run in runs) {
    if (run.branch() == info.default_branch() && !seen.contains(run.name())) {
      seen.add(run.name());
      print(${owner} + "/" + repo + " " + run.name() + " " + run.branch() + " " + run.status() + "/" + run.conclusion());
      if (run.status() != "completed" || run.conclusion() != "success") {
        report.add("ci-not-green", ${owner} + "/" + repo, run.name() + " " + run.url());
      }
    }
  }
  if (seen.len() == 0) { report.add("ci-missing", ${owner} + "/" + repo, "no default-branch runs in the 100-run window"); }
}
report.write_json("build/org-ci-health.json");
report.fail_if_any();
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
