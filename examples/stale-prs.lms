# Open PRs inactive for N days (default 30), with draft/conflict findings.
# Args: owner repo [days=30]; the cutoff is evaluated when the script starts.
owner = ARGV.len() > 0 ? ARGV[0] : "octo";
repo = ARGV.len() > 1 ? ARGV[1] : "demo";
days = ARGV.len() > 2 ? num(ARGV[2]) : 30;
cutoff = strftime(now() - days * 86400000, "%Y-%m-%d");
p = _lmcode_ cli="lmgh";
let prs = gh.search_prs("repo:" + ${owner} + "/" + ${repo} + " is:pr is:open updated:<" + ${cutoff}, 100);
for (i in range(0, prs.len())) {
  let pr = prs.at(i);
  let detail = gh.pr_view(${owner}, ${repo}, pr.number());
  print("STALE #" + str(detail.number()) + " " + detail.title() + " updated " + detail.updated_at());
  report.add("stale-pr", ${owner} + "/" + ${repo}, "#" + str(pr.number()) + " " + pr.url());
  if (detail.is_draft()) { print("DRAFT #" + str(detail.number())); report.add("stale-draft", ${owner} + "/" + ${repo}, "#" + str(detail.number())); }
  if (detail.mergeable() == "CONFLICTING") { print("CONFLICT #" + str(detail.number())); report.add("stale-conflict", ${owner} + "/" + ${repo}, "#" + str(detail.number())); }
}
report.write_text("build/stale-prs.txt");
report.fail_if_any();
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
