# Find open PRs with no approving review decision.
owner = ARGV.len() > 0 ? ARGV[0] : "octo";
repo = ARGV.len() > 1 ? ARGV[1] : "demo";
p = _lmcode_ cli="lmgh";
let prs = gh.search_prs("repo:" + ${owner} + "/" + ${repo} + " is:pr is:open", 100);
for (i in range(0, prs.len())) {
  let pr = prs.at(i);
  let triage = gh.pr_triage(${owner}, ${repo}, pr.number());
  if (triage.approved() == 0 && triage.review_decision() != "APPROVED") {
    print("UNREVIEWED #" + str(pr.number()) + " " + pr.title() + " decision=" + triage.review_decision());
    report.add("unreviewed-pr", ${owner} + "/" + ${repo}, "#" + str(pr.number()) + " " + pr.url());
  }
}
report.write_json("build/unreviewed-prs.json");
report.fail_if_any();
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
