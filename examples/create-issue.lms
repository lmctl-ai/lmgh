# Creates an issue. Pass --dry (as the 4th outer argument) to record the
# intent in the report without calling gh; otherwise the issue is created.
# Run:    lmscript examples/create-issue.lms <owner> <repo> <title> [body]
out = ARGV.len() > 0 ? ARGV[0] : "build/create-issue.dslb";
owner = ARGV.len() > 1 ? ARGV[1] : "octo";
repo = ARGV.len() > 2 ? ARGV[2] : "demo";
title = ARGV.len() > 3 ? ARGV[3] : "Test issue from lmgh";
body = ARGV.len() > 4 ? ARGV[4] : "Created by the lmgh create-issue example.";
dry = ARGV.len() > 5 ? ARGV[5] == "--dry" : true;

p = _lmcode_ cli="lmgh" install="github:lmctl-ai/lmgh@latest";
gh.dry_run(${dry});
let issue = gh.issue_create(${owner}, ${repo}, ${title}, ${body});
if (gh.is_dry_run()) {
  print("dry-run: would create issue in " + ${owner} + "/" + ${repo} + ": " + issue.title());
} else {
  print("created issue #" + str(issue.number()) + ": " + issue.url());
}
report.write_text("build/create-issue.txt");
end _lmcode_
savedsl(p, out);
