# Lists recent releases with tag, name and publish date.
# Run:    lmscript examples/release-notes.lms <owner> <repo>
out = ARGV.len() > 0 ? ARGV[0] : "build/release-notes.dslb";
owner = ARGV.len() > 1 ? ARGV[1] : "octo";
repo = ARGV.len() > 2 ? ARGV[2] : "demo";

p = _lmcode_ cli="lmgh" install="github:lmctl-ai/lmgh@latest";
let releases = gh.release_list(${owner}, ${repo}, 10);
for (i in range(0, releases.len())) {
  let rel = releases.at(i);
  let flags = "";
  if (rel.is_draft()) { flags = flags + " [draft]"; }
  if (rel.is_prerelease()) { flags = flags + " [prerelease]"; }
  print(rel.tag() + ": " + rel.name() + " (" + rel.published_at() + ")" + flags);
  report.add("release", rel.tag(), rel.name() + " " + rel.url());
}
report.write_text("build/release-notes.txt");
end _lmcode_
savedsl(p, out);
