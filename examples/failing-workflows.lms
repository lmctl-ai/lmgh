# Lists recent failing workflow runs and fails (exit 4) if any are found.
# Run:    lmscript examples/failing-workflows.lms <owner> <repo>
out = ARGV.len() > 0 ? ARGV[0] : "build/failing-workflows.dslb";
owner = ARGV.len() > 1 ? ARGV[1] : "octo";
repo = ARGV.len() > 2 ? ARGV[2] : "demo";

p = _lmcode_ cli="lmgh" install="github:lmctl-ai/lmgh@latest";
let runs = gh.run_list(${owner}, ${repo}, 20);
let failing = runs.failing();
for (i in range(0, failing.len())) {
  let run = failing.at(i);
  print("FAIL " + run.display_title() + " (" + run.branch() + ", " + run.conclusion() + ") " + run.url());
  report.add("failing-run", run.display_title(), run.url());
}
print("failing runs: " + str(failing.len()) + " of " + str(runs.len()) + " checked");
report.fail_if_any();
end _lmcode_
savedsl(p, out);
