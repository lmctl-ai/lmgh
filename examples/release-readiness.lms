# Check the newest non-draft, non-prerelease release and its latest CI run.
owner = ARGV.len() > 0 ? ARGV[0] : "octo";
repo = ARGV.len() > 1 ? ARGV[1] : "demo";
p = _lmcode_ cli="lmgh";
let info = gh.repo_view(${owner}, ${repo});
let releases = gh.release_list(${owner}, ${repo}, 30);
let found = false;
for (i in range(0, releases.len())) {
  let rel = releases.at(i);
  if (!found && !rel.is_draft() && !rel.is_prerelease()) {
    found = true;
    print("RELEASE " + rel.tag() + " " + rel.name());
  }
}
if (!found) { report.add("release-missing", ${owner} + "/" + ${repo}, "no stable release"); }
let runs = gh.run_list(${owner}, ${repo}, 100);
let seen = str_list();
for (run in runs) {
  if (run.branch() == info.default_branch() && !seen.contains(run.name())) {
    seen.add(run.name());
    print("CI " + run.name() + " " + run.status() + "/" + run.conclusion());
    if (run.status() != "completed" || run.conclusion() != "success") { report.add("ci-not-green", ${owner} + "/" + ${repo}, run.url()); }
  }
}
if (seen.len() == 0) { report.add("ci-missing", ${owner} + "/" + ${repo}, "no default-branch runs in the 100-run window"); }
report.write_text("build/release-readiness.txt");
report.fail_if_any();
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
