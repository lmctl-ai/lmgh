# Triage digest for one pull request: checks, reviews and mergeability.
# Run:    lmscript examples/pr-triage.lms <owner> <repo> <number>
out = ARGV.len() > 0 ? ARGV[0] : "build/pr-triage.dslb";
owner = ARGV.len() > 1 ? ARGV[1] : "octo";
repo = ARGV.len() > 2 ? ARGV[2] : "demo";
number = ARGV.len() > 3 ? num(ARGV[3]) : 21;

p = _lmcode_ cli="lmgh" install="github:lmctl-ai/lmgh@latest";
let t = gh.pr_triage(${owner}, ${repo}, ${number});
print("#" + str(t.number()) + ": " + t.title());
print(t.summary());
if (t.ok()) {
  print("triage: OK to merge");
} else {
  print("triage: NOT ready (checks failing " + str(t.checks_failing()) + ", changes requested " + str(t.changes_requested()) + ")");
  report.add("pr-not-ready", ${owner} + "/" + ${repo} + "#" + str(t.number()), t.summary());
}
report.write_text("build/pr-triage.txt");
end _lmcode_
savedsl(p, out);
