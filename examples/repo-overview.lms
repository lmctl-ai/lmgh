# Repository overview for owner/repo: metadata plus a small health summary.
# Run:    lmscript examples/repo-overview.lms <owner> <repo>
owner = ARGV.len() > 0 ? ARGV[0] : "octo";
repo = ARGV.len() > 1 ? ARGV[1] : "demo";

p = _lmcode_ cli="lmgh";
let r = gh.repo_view(${owner}, ${repo});
print(r.full_name() + ": " + r.description());
print("default branch: " + r.default_branch() + ", license: " + r.license());
print("stars: " + str(r.stars()) + ", forks: " + str(r.forks()) + ", open issues: " + str(r.open_issues()));
let topics = r.topics();
let t = "";
for (i in range(0, topics.len())) {
  t = t + topics.at(i);
  if (i + 1 < topics.len()) { t = t + ", "; }
}
print("topics: " + t);
report.add("overview", r.full_name(), "pushed at " + r.pushed_at());
report.write_text("build/repo-overview.txt");
end _lmcode_
r = run_lmcode(p);
if (!r.ok) {
  print("lmgh " + r.phase + " " + r.code + ": " + r.message);
  exit(r.code == "APP_FAIL" ? 4 : 3);
}
